# PostgreSQL connection string used by Drizzle and the session store
DATABASE_URL=postgresql://user:password@localhost:5432/trading_journal

# Secret used to sign session cookies - use a long random string
SESSION_SECRET=change-this-session-secret-in-production

# Dashboard login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-in-production

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
